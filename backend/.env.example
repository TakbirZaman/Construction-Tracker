# ─── Database ──────────────────────────────────────────────────────────────────
# Your PostgreSQL connection string from Render/Fly.io/Railway etc.
# Format: postgresql://username:password@host:port/database
DATABASE_URL=postgresql://user:password@localhost:5432/constructtrack

# ─── JWT ───────────────────────────────────────────────────────────────────────
# Required. Generate a secure random string: openssl rand -hex 64
JWT_SECRET=your-super-secret-jwt-key-change-in-production

# ─── CORS ──────────────────────────────────────────────────────────────────────
# Extra allowed origin for production (optional).
CORS_ORIGIN=https://your-frontend-domain.com

# ─── Server ────────────────────────────────────────────────────────────────────
PORT=5000
NODE_ENV=development
